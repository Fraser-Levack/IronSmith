// Lighthouse island at dusk: a striped tower with a glowing lantern, the
// keeper's cottage, a sailboat and seagulls over a sea that mirrors the sky.
// Sea level is y = 0.

light(-0.8, 0.55, 0.9, 1.05)

// ── Sea (metal mirrors the sunset sky) ─────────────────
material(metal, paint(#2C5C78, move(0, -0.2, 0, cylinder(19, 0.4))))

// ── Rocky island with a grassy top ─────────────────────
islandRock = group(move(0, -0.4, 0, scale(6.5, 2.4, 5.5, sphere(1))),
                   move(3.5, -0.6, 2.5, scale(3.5, 1.8, 3, sphere(1))),
                   move(-3.8, -0.8, -1.5, scale(3.2, 1.9, 3.4, sphere(1))))
paint(#7A6A58, islandRock)
// A slightly larger copy of the rock, trimmed to its top, sits over it like a lid
grassCap = intersection(group(move(0, -0.4, 0, scale(6.6, 2.48, 5.6, sphere(1))), move(3.5, -0.6, 2.5, scale(3.6, 1.88, 3.1, sphere(1)))),
                        move(0, 2.4, 0, cube(20, 2, 20)))
paint(#5D8C3A, grassCap)
boulder = scale(1, 0.7, 0.9, sphere(1))
paint(#57504A, move(6.8, 0.1, -1.5, scale(1.1, boulder)), move(7.6, -0.1, 0.6, scale(0.7, boulder)), move(-6.5, 0.0, 3.2, scale(0.9, boulder)),
               move(2, -0.1, 7.2, scale(0.8, boulder)), move(-2.5, -0.1, -6.8, scale(1.2, boulder)), move(10, -0.1, 6, scale(0.6, boulder)))

// ── Lighthouse ─────────────────────────────────────────
baseY = 1.9
towerH = 9
tower = move(-1.2, baseY + towerH / 2, -0.6, cone(1.55, 1.05, towerH))
bands = move(0, baseY + 1.6, 0, repeat(0, 2.6, 0, cube(20, 1.3, 20)))
paint(#F2EDE4, tower)
material(plastic, paint(#C8322B, intersection(move(-1.2, baseY + towerH / 2, -0.6, cone(1.58, 1.08, towerH - 0.1)), bands)))
// Door and two little windows
paint(#3B2A20, move(-0.05, baseY + 0.7, -0.6, cube(0.5, 1.3, 0.75)))
material(neon, paint(#FFC66B, move(-0.25, baseY + 4.6, -0.6, cube(0.3, 0.55, 0.38)), move(-0.42, baseY + 6.9, -0.6, cube(0.3, 0.5, 0.34))))

// Gallery, railing, lantern room and roof
topY = baseY + towerH
paint(#2E2E33, move(-1.2, topY + 0.1, -0.6, cylinder(1.5, 0.22)))
material(metal, paint(#4A4A52, move(-1.2, topY + 0.75, -0.6, torus(1.42, 0.05)), move(-1.2, topY + 0.45, -0.6, torus(1.42, 0.03))))
material(neon, paint(#FFD86B, move(-1.2, topY + 0.85, -0.6, cylinder(0.78, 1.3))))
material(metal, paint(#3A3A40, move(-1.2, topY + 0.85, -0.6, difference(cylinder(0.82, 1.3), group(cube(0.3, 2, 3), cube(3, 2, 0.3), rotateY(45, cube(3, 2, 0.3)), rotateY(-45, cube(3, 2, 0.3)))))))
material(plastic, paint(#B02A24, move(-1.2, topY + 2.0, -0.6, cone(1.05, 1.0))))
material(metal, paint(#C9A24A, move(-1.2, topY + 2.6, -0.6, sphere(0.16)), move(-1.2, topY + 2.9, -0.6, cylinder(0.03, 0.6))))

// ── Keeper's cottage ───────────────────────────────────
cotX = 2.8
cotZ = 1.4
cotY = 1.85
paint(#EFE6D2, move(cotX, cotY + 0.8, cotZ, cube(3, 1.6, 2.2)))
roof = intersection(rotateX(45, cube(3.4, 1.9, 1.9)), move(0, 0.75, 0, cube(4, 1.5, 4)))
material(plastic, paint(#3E5C7A, move(cotX, cotY + 1.6, cotZ, roof)))
paint(#7A5A44, move(cotX + 0.8, cotY + 2.3, cotZ - 0.5, cube(0.35, 0.9, 0.35)))
material(neon, paint(#FFB858, move(cotX + 1.52, cotY + 0.85, cotZ - 0.5, cube(0.06, 0.55, 0.5)), move(cotX + 1.52, cotY + 0.85, cotZ + 0.55, cube(0.06, 0.55, 0.5)),
                   move(cotX - 0.4, cotY + 0.85, cotZ + 1.12, cube(0.6, 0.55, 0.06))))
paint(#4A3426, move(cotX + 0.6, cotY + 0.6, cotZ + 1.12, cube(0.5, 1.2, 0.07)))
// Picket fence along the front of the garden
picket = cube(0.08, 0.5, 0.06)
paint(#F2EDE4, move(4.9, 2.0, 0.0, picket), move(4.9, 2.0, 0.4, picket), move(4.9, 2.0, 0.8, picket), move(4.9, 2.0, 1.2, picket),
               move(4.9, 2.0, 1.6, picket), move(4.9, 2.0, 2.0, picket), move(4.9, 2.0, 2.4, picket), move(4.9, 2.0, 2.8, picket),
               move(4.9, 2.1, 1.4, cube(0.05, 0.08, 3.0)))

// Path from the cottage to the lighthouse
paint(#B9AD98, move(0.7, 1.86, 0.5, scale(1, 0.15, 0.7, sphere(0.35))), move(1.4, 1.86, 0.7, scale(1, 0.15, 0.7, sphere(0.3))), move(0.2, 1.86, 0.0, scale(1, 0.15, 0.7, sphere(0.32))))

// ── Sailboat ───────────────────────────────────────────
boatX = 9
boatZ = -5.5
hull = intersection(scale(2.1, 0.7, 0.75, sphere(1)), move(0, -0.4, 0, cube(5, 0.8, 2)))
paint(#7B4A2E, move(boatX, 0.35, boatZ, rotateY(-25, hull)))
paint(#E9E2D3, move(boatX, 0.36, boatZ, rotateY(-25, move(0, 0.01, 0, scale(1.9, 0.02, 0.6, sphere(1))))))
paint(#5A3A26, move(boatX, 2.0, boatZ, cylinder(0.06, 3.2)))
// Triangular sail: a 1.8 x 2.8 panel cut along its diagonal by a big box
// rotated so its top face lies on the line from (0, 2.8) to (1.8, 0).
panel = move(0.9, 1.4, 0, cube(1.8, 2.8, 0.06))
underDiagonal = move(-4.2, 0.1, 0, rotateZ(57.3, cube(10, 10, 10)))
sail = intersection(panel, underDiagonal)
paint(#F7F1E3, move(boatX, 0.55, boatZ, rotateY(-25, move(0.08, 0, 0, sail))))
material(neon, paint(#FF6B4A, move(boatX, 3.65, boatZ, rotateY(-25, cube(0.5, 0.22, 0.03)))))

// ── Seagulls ───────────────────────────────────────────
wingSeg = cube(0.55, 0.05, 0.12)
gull = group(move(-0.24, 0.1, 0, rotateZ(-25, wingSeg)), move(0.24, 0.1, 0, rotateZ(25, wingSeg)))
paint(#FAFAF5, move(3, 9.5, 4, rotateY(30, gull)), move(5.5, 11, 1.5, rotateY(-20, scale(0.8, gull))), move(1.5, 12.5, 6, rotateY(60, scale(0.9, gull))))

// ── Evening sky: crescent moon and first stars ─────────
moon = difference(sphere(1.6), move(-0.9, 0.4, 1.1, sphere(1.45)))
material(neon, paint(#FFF1C4, move(-10, 16, -14, moon)))
star = sphere(0.08)
material(neon, paint(#FFFFFF, move(-4, 19, -16, star), move(4, 18, -18, star), move(-14, 12, -12, star), move(10, 17, -12, star),
                            move(-7, 21, -10, star), move(1, 22, -14, star), move(13, 14, -14, star), move(-16, 17, -4, star)))

// ── Turntable: press Ctrl+A in the editor to play ────────
camera(0, 55, 14, 26.0, 0, 5, 0)
camera(10, 415, 14, 26.0, 0, 5, 0)
