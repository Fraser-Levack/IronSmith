// "Bolt", a friendly little robot waving hello next to its potted plant.
// Faces +X, standing on the ground at y = 0.

light(1.2, 2.0, 0.6, 1.15)

// ── Ground disc ────────────────────────────────────────
paint(#E9DFC9, move(0, -0.15, 0, cylinder(4.6, 0.3)))
paint(#D8CBAE, move(0, -0.16, 0, cylinder(4.75, 0.28)))

// ── Feet and legs ──────────────────────────────────────
foot = scale(0.75, 0.32, 0.5, sphere(1))
material(plastic, paint(#F28C38, move(0.25, 0.3, 0.62, foot), move(0.25, 0.3, -0.62, foot)))
leg = cylinder(0.24, 1.2)
material(metal, paint(#9AA3AD, move(0, 1.0, 0.62, leg), move(0, 1.0, -0.62, leg)))

// ── Body: a rounded barrel ─────────────────────────────
bodyY = 2.65
body = move(0, bodyY, 0, intersection(cylinder(1.35, 2.3), sphere(1.62)))
belt = move(0, bodyY - 0.75, 0, cylinder(1.3, 0.22))
material(plastic, paint(#5CC8B8, body))
paint(#3E9C8F, belt)

// Chest panel with three buttons and a glowing heart
paint(#1D2433, move(1.12, bodyY + 0.15, 0, scale(0.28, 0.55, 0.72, sphere(1))))
button = scale(0.5, 1, 1, sphere(0.11))
material(neon, paint(#FF5A5A, move(1.33, bodyY + 0.42, -0.3, button)))
material(neon, paint(#FFD84D, move(1.36, bodyY + 0.42, 0.0, button)))
material(neon, paint(#6BFF8A, move(1.33, bodyY + 0.42, 0.3, button)))
heart = group(move(0, 0.07, 0.08, sphere(0.1)), move(0, 0.07, -0.08, sphere(0.1)), move(0, -0.05, 0, rotateX(45, cube(0.1, 0.16, 0.16))))
material(neon, paint(#FF6F91, move(1.38, bodyY - 0.05, 0, heart)))

// ── Neck and head ──────────────────────────────────────
material(metal, paint(#9AA3AD, move(0, 4.15, 0, cylinder(0.32, 0.6))))
headY = 5.25
head = move(0, headY, 0, intersection(cube(2.5, 2.1, 2.6), sphere(1.6)))
material(plastic, paint(#F4EFE3, head))

// Face screen, eyes, cheeks and smile
paint(#1D2433, move(0.98, headY, 0, scale(0.4, 0.72, 1.0, sphere(1))))
eye = scale(0.08, 0.3, 0.2, sphere(1))
material(neon, paint(#59E1FF, move(1.36, headY + 0.13, 0.38, eye), move(1.36, headY + 0.13, -0.38, eye)))
paint(#FFFFFF, move(1.43, headY + 0.24, 0.32, sphere(0.06)), move(1.43, headY + 0.24, -0.44, sphere(0.06)))
cheek = scale(0.06, 0.1, 0.16, sphere(1))
material(neon, paint(#FF8FA8, move(1.34, headY - 0.22, 0.68, cheek), move(1.34, headY - 0.22, -0.68, cheek)))
smile = intersection(rotateZ(90, torus(0.22, 0.045)), move(0, -0.2, 0, cube(1, 0.36, 1)))
material(neon, paint(#59E1FF, move(1.38, headY - 0.12, 0, smile)))

// Ear bolts on each side of the head
ear = rotateX(90, cylinder(0.42, 0.32))
material(plastic, paint(#F28C38, move(0, headY, 1.38, ear), move(0, headY, -1.38, ear)))
material(metal, paint(#9AA3AD, move(0, headY, 1.6, rotateX(90, cylinder(0.18, 0.3))), move(0, headY, -1.6, rotateX(90, cylinder(0.18, 0.3)))))

// Antenna with a glowing tip
material(metal, paint(#9AA3AD, move(0, headY + 1.25, 0, cylinder(0.07, 0.9)), move(0, headY + 0.98, 0, sphere(0.2))))
material(neon, paint(#FF5A5A, move(0, headY + 1.85, 0, sphere(0.24))))

// ── Arms ───────────────────────────────────────────────
shoulderY = 3.35
arm = group(move(0, -0.75, 0, cylinder(0.2, 1.5)), move(0, -1.62, 0, sphere(0.36)))
claw = move(0, -1.95, 0, intersection(rotateZ(90, torus(0.26, 0.08)), move(0, -0.2, 0, cube(1, 0.4, 1))))
material(metal, paint(#9AA3AD, move(0, shoulderY, 1.5, sphere(0.36)), move(0, shoulderY, -1.5, sphere(0.36))))
// Resting arm on the +Z side, swung slightly outward
material(plastic, paint(#5CC8B8, move(0, shoulderY, 1.55, rotateX(14, arm))))
material(metal, paint(#9AA3AD, move(0, shoulderY, 1.55, rotateX(14, claw))))
// Waving arm on the -Z side, raised high
material(plastic, paint(#5CC8B8, move(0, shoulderY, -1.55, rotateX(-140, arm))))
material(metal, paint(#9AA3AD, move(0, shoulderY, -1.55, rotateX(-140, claw))))

// ── Potted plant ───────────────────────────────────────
potX = 1.4
potZ = 2.6
material(plastic, paint(#C8693F, move(potX, 0.45, potZ, cone(0.38, 0.52, 0.9))))
paint(#5A3B22, move(potX, 0.88, potZ, cylinder(0.46, 0.06)))
paint(#3F9E4D, move(potX, 1.35, potZ, cylinder(0.05, 0.9)))
leaf = scale(0.32, 0.06, 0.14, sphere(1))
paint(#4DB85C, move(potX + 0.25, 1.2, potZ, rotateZ(25, leaf)), move(potX - 0.22, 1.45, potZ, rotateZ(-25, leaf)), move(potX, 1.3, potZ + 0.22, rotateY(90, rotateZ(25, leaf))))
petal = scale(0.16, 0.06, 0.16, sphere(1))
material(plastic, paint(#FF9EC4, move(potX + 0.14, 1.85, potZ, petal), move(potX - 0.14, 1.85, potZ, petal), move(potX, 1.85, potZ + 0.14, petal), move(potX, 1.85, potZ - 0.14, petal)))
material(neon, paint(#FFE15A, move(potX, 1.88, potZ, sphere(0.09))))

// ── A few loose bolts on the ground ────────────────────
bolt = group(cylinder(0.12, 0.08), move(0, 0.12, 0, cylinder(0.05, 0.25)))
material(metal, paint(#B8C0C8, move(2.4, 0.04, -1.6, bolt), move(-1.8, 0.04, 2.3, rotateZ(90, bolt)), move(2.9, 0.04, 0.4, bolt)))

// ── Turntable: press Ctrl+A in the editor to play ────────
camera(0, 62, 12, 10.0, 0, 3.0, 0)
camera(6, 422, 12, 10.0, 0, 3.0, 0)
