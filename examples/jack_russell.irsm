// A scruffy, rough-coated Jack Russell terrier sitting on an autumn lawn.
// White shaggy coat, tan ears and eye patches with a white blaze,
// beard under the muzzle, fluffy tail out to the side.
// Ground at y = 0; the dog faces +X.

light(0.6, 0.9, 0.5, 1.2)


// ── Lawn and leaves ───────────────────────────────────
paint(#4F7F2E, move(0, -0.2, 0, cylinder(9, 0.4)))
leaf = scale(1, 0.05, 0.6, sphere(0.6))
paint(#E08A2E, move(4.5, 0.02, 3.5, rotateY(30, leaf)), move(-3, 0.02, 5, rotateY(-40, leaf)), move(5.5, 0.02, -3, rotateY(70, leaf)))
paint(#C9562A, move(3.5, 0.02, -5, rotateY(10, leaf)), move(-5, 0.02, -2.5, rotateY(80, leaf)), move(6.5, 0.02, 1, rotateY(-20, leaf)))
paint(#E6B23C, move(-1, 0.02, 6, rotateY(50, leaf)), move(1.5, 0.02, 6.5, rotateY(-60, leaf)))

// ── Body (sitting) ────────────────────────────────────
torso = move(0.4, 3.9, 0, rotateZ(22, scale(1.9, 2.9, 1.9, sphere(1))))
rump = move(-1.4, 1.9, 0, scale(1.9, 1.7, 1.8, sphere(1)))
haunches = group(move(-0.9, 1.7, 1.25, scale(1.7, 1.5, 1.0, sphere(1))), move(-0.9, 1.7, -1.25, scale(1.7, 1.5, 1.0, sphere(1))))
frontLegs = group(move(1.75, 1.9, 0.85, cylinder(0.5, 3.8)), move(1.75, 1.9, -0.85, cylinder(0.5, 3.8)))
neck = move(1.3, 6.0, 0, scale(1.35, 1.6, 1.35, sphere(1)))
body = group(torso, rump, haunches, frontLegs, neck)

// Slightly inflated copy: the fur layer is clipped to this
f = 0.3
torsoF = move(0.4, 3.9, 0, rotateZ(22, scale(1.9 + f, 2.9 + f, 1.9 + f, sphere(1))))
rumpF = move(-1.4, 1.9, 0, scale(1.9 + f, 1.7 + f, 1.8 + f, sphere(1)))
haunchF = group(move(-0.9, 1.7, 1.25, scale(1.7 + f, 1.5 + f, 1.0 + f, sphere(1))), move(-0.9, 1.7, -1.25, scale(1.7 + f, 1.5 + f, 1.0 + f, sphere(1))))
legsF = group(move(1.75, 2.2, 0.85, cylinder(0.5 + f, 3.4)), move(1.75, 2.2, -0.85, cylinder(0.5 + f, 3.4)))
neckF = move(1.3, 6.0, 0, scale(1.35 + f, 1.6 + f, 1.35 + f, sphere(1)))
furZone = group(torsoF, rumpF, haunchF, legsF, neckF)

// Hanging strands: downward-pointing cones tiled through space, two offset
// layers, kept only where they overlap the fur zone
strand = rotateZ(180, cone(0.11, 0.5))
strandsA = repeat(0.26, 0.42, 0.26, strand)
strandsB = move(0.13, 0.21, 0.13, rotateY(25, repeat(0.26, 0.42, 0.26, strand)))
strandsC = move(0.05, 0.1, 0.07, rotateY(-40, rotateZ(10, repeat(0.37, 0.47, 0.37, cone(0.1, 0.5)))))
strands = group(strandsA, strandsB, strandsC)
fur = intersection(strands, furZone)

paint(#F3EFE6, body, fur)

// Paws
paint(#E9DFCC,
    move(2.0, 0.32, 0.85, scale(0.75, 0.38, 0.58, sphere(1))),
    move(2.0, 0.32, -0.85, scale(0.75, 0.38, 0.58, sphere(1))),
    move(0.3, 0.32, 1.9, scale(1.0, 0.38, 0.55, sphere(1))),
    move(0.3, 0.32, -1.9, scale(1.0, 0.38, 0.55, sphere(1))))

// Collar, mostly buried in the ruff
paint(#D9636E, move(1.35, 5.6, 0, rotateZ(28, torus(1.3, 0.14))))

// ── Tail: fluffy, out to the side and up ─────────────
tail = move(-2.6, 2.8, -1.6, rotateX(-35, rotateZ(40, scale(0.45, 1.7, 0.45, sphere(1)))))
tailFur = intersection(strands, move(-2.6, 2.8, -1.6, rotateX(-35, rotateZ(40, scale(0.75, 1.9, 0.75, sphere(1))))))
paint(#F3EFE6, tail, tailFur)

// ── Head ──────────────────────────────────────────────
hx = 1.7
hy = 7.8
head = move(hx, hy, 0, scale(1.65, 1.55, 1.6, sphere(1)))
muzzle = move(hx + 1.55, hy - 0.55, 0, scale(1.05, 0.75, 0.8, sphere(1)))
paint(#F3EFE6, head, muzzle)

// Tan "mask" on the sides of the head, leaving a white blaze down the middle
headSkin = move(hx, hy, 0, scale(1.7, 1.6, 1.65, sphere(1)))
tanSides = group(move(hx, hy + 0.55, 1.4, sphere(1.25)), move(hx, hy + 0.55, -1.4, sphere(1.25)),
                 move(hx + 0.9, hy + 0.3, 1.05, sphere(0.68)), move(hx + 0.9, hy + 0.3, -1.05, sphere(0.68)))
paint(#C8935A, intersection(headSkin, tanSides))

// Folded ears: flaps from the top of the head tipping forward and down
ear = scale(0.55, 0.9, 0.18, sphere(1))
paint(#A8723F,
    move(hx + 0.55, hy + 0.8, 1.4, rotateX(20, rotateZ(130, ear))),
    move(hx + 0.55, hy + 0.8, -1.4, rotateX(-20, rotateZ(130, ear))))

// Scruffy back of the head, blending into the neck ruff
backOfHead = difference(move(hx, hy, 0, scale(1.95, 1.85, 1.9, sphere(1))), move(hx + 1.6, hy, 0, cube(3.2, 5, 5)))
paint(#F3EFE6, intersection(strands, backOfHead))

// Shaggy face: cheek/beard of hanging strands
faceFurZone = group(move(hx + 1.3, hy - 1.1, 0, scale(1.05, 0.75, 1.0, sphere(1))),
                    move(hx + 0.9, hy - 0.85, 0.8, sphere(0.6)), move(hx + 0.9, hy - 0.85, -0.8, sphere(0.6)))
paint(#F3EFE6, intersection(strands, faceFurZone))
paint(#F3EFE6, move(hx + 1.9, hy - 1.5, 0, rotateZ(180, cone(0.35, 0.9))),
             move(hx + 1.65, hy - 1.45, 0.4, rotateZ(170, cone(0.3, 0.8))),
             move(hx + 1.65, hy - 1.45, -0.4, rotateZ(170, cone(0.3, 0.8))))

// Eyes, nose and mouth
eye = sphere(0.24)
material(plastic, paint(#4A2410, move(hx + 1.4, hy + 0.3, 0.62, eye), move(hx + 1.4, hy + 0.3, -0.62, eye)))
paint(#111111, move(hx + 1.57, hy + 0.31, 0.64, sphere(0.12)), move(hx + 1.57, hy + 0.31, -0.64, sphere(0.12)))
material(plastic, paint(#121212, move(hx + 2.55, hy - 0.3, 0, scale(0.3, 0.26, 0.36, sphere(1)))))
paint(#2A1A14, move(hx + 2.25, hy - 1.05, 0, scale(0.25, 0.06, 0.32, sphere(1))))
