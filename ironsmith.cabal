cabal-version:      2.4
name:               ironsmith
version:            0.1.0.0
synopsis:           A 3D modeling scripting language
author:             The IronSmith Forge
maintainer:         user@example.com

executable ironsmith
    main-is:          Main.hs
    other-modules:    AST,
                      Parser,
                      Evaluator,
                      Exporter,
                      Config,
                      AppState,
                      AppCore,
                      AppUI,
                      AppEvents

    hs-source-dirs:   app, src
    default-language: Haskell2010

    -- Tell GHC to use the multi-threaded runtime, and optimise (the OBJ
    -- exporter samples the SDF over a large grid and benefits a lot from -O2)
    ghc-options:      -threaded -O2

    build-depends:    base >= 4.14 && < 5,
                      megaparsec,
                      text,
                      containers,
                      parser-combinators,
                      brick,
                      vty,
                      vty-crossplatform,
                      mtl,
                      microlens,
                      directory,
                      filepath,
                      process,
                      network,
                      bytestring,
                      array